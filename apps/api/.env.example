# Copy to apps/api/.env for local development. Never commit real values.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Async SQLAlchemy URL. Matches docker-compose.yml locally.
DATABASE_URL=postgresql+asyncpg://aeroguide:aeroguide@localhost:5432/aeroguide
# Optional. Use rediss:// (TLS) for Upstash. Leave empty to run without Redis (the live
# snapshot and route caches then stay in memory and don't survive a restart).
REDIS_URL=redis://localhost:6379/0
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# OpenSky API client (free account, Account > API client). Optional; without it OpenSky is
# used anonymously with a small per-IP allowance. Set real values only in Render's env.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Per-client requests per minute on the REST API (the MCP endpoint has MCP_RATE_LIMIT_PER_MINUTE).
API_RATE_LIMIT_PER_MINUTE=120

# Fare search (ADR-0015). Ignav is paid after a one-time free allowance of 1,000 requests.
# Every upstream request is counted in Postgres and capped; searches show a reminder at 95%.
# Leave IGNAV_API_KEY empty to turn fare search off. FARE_PROVIDERS=mock gives demo fares.
IGNAV_API_KEY=
FARE_PROVIDERS=ignav
IGNAV_MARKET=IN
FARES_TOTAL_REQUEST_CAP=900
FARES_DAILY_REQUEST_CAP=100
FARES_MONTHLY_REQUEST_CAP=
FARES_BUDGET_WARN_RATIO=0.95
FARES_CACHE_TTL_S=600
FARES_BEST_WEIGHTS=0.6,0.3,0.1
FARES_RATE_LIMIT_PER_MINUTE=10
# Live fare searches all AI assistants may make per IST day through the MCP tool (inside the
# caps above). 0 turns them off. SITE_URL is used for links to the fares page in results.
FARES_MCP_DAILY_REQUEST_CAP=20
SITE_URL=https://aeroguide-theta.vercel.app
