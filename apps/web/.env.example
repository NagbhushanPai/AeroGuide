# Server-side base URL of the FastAPI service (used in server components and at build time).
API_BASE_URL=http://localhost:8000
# Browser-visible API base URL (used for live polling). Not a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Public site URL for canonical links, the sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://aeroguide-theta.vercel.app
